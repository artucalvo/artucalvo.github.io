{"id":"pedro-pena","name":"Pedro Peña Rodríguez","givenNames":"Pedro","surnames":["Peña","Rodríguez"],"birth":{"date":"1678-07-11","place":"Muga de Alba","note":"La fecha es la del bautismo; no consta la del nacimiento."},"marriages":[{"spouse":"teresa-dominguez","date":"1713-04-26","place":"Muga de Alba"}],"father":"antonio-pena","mother":"antonia-rodriguez","baptism":{"date":"1678-07-11","place":"Muga de Alba","transcription":"Pedro.\n\nEn once de Julio de mill y seiscientos y setenta y ocho, yo el infraescrito cura de Muga y sus anexos bauticé solemnemente un niño que se llamó Pedro, hijo lexítimo de Antonio Peña y de Antonia Rodríguez; fueron sus padrinos Gregorio Gago y María Prieta, todos vecinos deste lugar, y lo firmé. Antº de Mattos."},"isDirectAncestor":true,"parentSummaries":[{"id":"antonio-pena","name":"Antonio Peña","givenNames":"Antonio","surnames":["Peña"],"isDirectAncestor":true,"relation":"father"},{"id":"antonia-rodriguez","name":"Antonia Rodríguez","givenNames":"Antonia","surnames":["Rodríguez"],"isDirectAncestor":true,"relation":"mother"}],"children":[{"id":"maria-de-la-pena","name":"María Peña Domínguez","givenNames":"María","surnames":["Peña","Domínguez"],"isDirectAncestor":true,"father":"pedro-pena","mother":"teresa-dominguez"}],"partners":[{"id":"teresa-dominguez","name":"Teresa Domínguez","givenNames":"Teresa","surnames":["Domínguez"],"isDirectAncestor":true,"sharedChildren":["maria-de-la-pena"]}]}
