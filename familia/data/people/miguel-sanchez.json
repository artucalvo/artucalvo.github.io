{"id":"miguel-sanchez","name":"Miguel Sánchez García","givenNames":"Miguel","surnames":["Sánchez","García"],"birth":{"date":"1662-05-08","place":"La Hiniesta"},"father":"juan-sanchez-padre-de-miguel-sanchez","mother":"vadalisa-garcia","marriages":[{"spouse":"manuela-martin-madre-de-basilisa-sanchez","date":"1684-11-26","place":"La Hiniesta","transcription":"En veinte y seis de nobiembre de 1684 desposé y velé in fazie eclesie, aviendo precedido las tres admonestaziones que ordena el Sto C. de T., a Miguel Sánchez con Manuela Martín. Fueron sus padrinos Manuel Rodríguez y María Sánchez. Testigos Pedro González, Manuel [ilegible] Billasante, Juan Calvo, que se allaron presentes; en fe de ello lo firmé. Germo Sánchez de Balvoa."}],"parentSummaries":[{"id":"juan-sanchez-padre-de-miguel-sanchez","name":"Juan Sánchez","givenNames":"Juan","surnames":["Sánchez"],"relation":"father"},{"id":"vadalisa-garcia","name":"Vadalisa García","givenNames":"Vadalisa","surnames":["García"],"relation":"mother"}],"children":[{"id":"basilisa-sanchez","name":"Basilisa Sánchez Martín","givenNames":"Basilisa","surnames":["Sánchez","Martín"],"father":"miguel-sanchez","mother":"manuela-martin-madre-de-basilisa-sanchez"}],"partners":[{"id":"manuela-martin-madre-de-basilisa-sanchez","name":"Manuela Martín","givenNames":"Manuela","surnames":["Martín"],"sharedChildren":["basilisa-sanchez"]}]}
