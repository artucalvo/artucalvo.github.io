{"id":"alonso-izquierdo","name":"Alonso Izquierdo","givenNames":"Alonso","surnames":["Izquierdo"],"death":{"date":"1694-02-06","place":"El Cubo del Vino","transcription":"Alonsso. Cumpliose el testamento.\n\nEn seis de febrero murió Alonso Izquierdo. Recibió los Santos Sacramentos, hiço testamento y dejó por su alma cien reales y fueron sus testamentarios Alonso García y Mathías de los Reyes vecinos desta villa y se enterró en el cuerpo de la yglesia y se ha cumplido su testamento y lo firmé ut supra. Santiago Martínez."},"isDirectAncestor":true,"marriages":[{"spouse":"teresa-hernandez-madre-de-miguel-izquierdo"}],"children":[{"id":"miguel-izquierdo","name":"Miguel Izquierdo Hernández","givenNames":"Miguel","surnames":["Izquierdo","Hernández"],"isDirectAncestor":true,"father":"alonso-izquierdo","mother":"teresa-hernandez-madre-de-miguel-izquierdo"},{"id":"pedro-hijo-de-alonso-izquierdo","name":"Pedro Izquierdo Hernández","givenNames":"Pedro","surnames":["Izquierdo","Hernández"],"father":"alonso-izquierdo","mother":"teresa-hernandez-madre-de-miguel-izquierdo"}],"partners":[{"id":"teresa-hernandez-madre-de-miguel-izquierdo","name":"Teresa Hernández","givenNames":"Teresa","surnames":["Hernández"],"isDirectAncestor":true,"sharedChildren":["miguel-izquierdo","pedro-hijo-de-alonso-izquierdo"]}]}
